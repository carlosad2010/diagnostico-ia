# --- Proveedores de IA ---
# Gemini es el principal. OpenRouter es el respaldo: se usa solo cuando todos los modelos de Gemini
# fallan (saturados, sin cuota o caídos), o como principal si no hay GEMINI_API_KEY.
# Crea la key en https://openrouter.ai/keys. "openrouter/free" elige al azar entre modelos gratuitos.
# Límite gratuito: 20 peticiones/minuto y 50/día (1.000/día si compras al menos 10 USD en créditos).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Gemini (principal)
GEMINI_API_KEY=Aqui tu API key de Gemini (https://aistudio.google.com/app/apikey)

# --- Base de datos PostgreSQL (si falta, en local se usa la memoria del proceso) ---
# Local: createdb diagnostico_ia && psql -d diagnostico_ia -f database/schema.sql
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/diagnostico_ia
# Neon (Vercel): usa la cadena "pooled" (host con -pooler) y sslmode=require
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
APP_URL=https://tu-dominio.vercel.app

# --- Opcionales ---
GEMINI_MODEL=gemini-3.5-flash-lite          # modelo de la entrevista
GEMINI_MODEL_ANALISIS=gemini-3.5-flash-lite # modelo del diagnóstico final (prueba uno más capaz)
GEMINI_MODELOS_RESPALDO=gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-3.5-flash # si el modelo está saturado (503) o sin cuota (429), prueba estos en orden
FACTOR_REALIZACION=0.6                      # 0,5 a 0,8: ahorro esperado frente al teórico
MAX_TURNOS=40                               # mensajes máximos por sesión

# Correo por SMTP con nodemailer (si faltan, no se envía correo)
# Gmail: smtp.gmail.com, puerto 587 y una "contraseña de aplicación" (no la contraseña normal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false                           # true solo para el puerto 465
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=
CORREO_REMITENTE=Studio-IA <diagnostico@tudominio.com>
CORREO_COPIA=tu-correo@tudominio.com

# Pruebas: MOCK_AI=1 responde con un guion simulado sin gastar cuota
# MOCK_AI=1

# Panel administrativo (/admin): contraseña del dueño (mínimo 8 caracteres). Sin ella, el panel no se activa.
ADMIN_PASSWORD=
# Análisis final: nivel de razonamiento (low, medium o high)
# GEMINI_RAZONAMIENTO_ANALISIS=medium
